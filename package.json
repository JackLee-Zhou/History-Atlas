{
  "name": "history-atlas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "description": "把历史文本里的空间叙事还原成可追溯的态势图",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:secrets",
    "check:secrets": "node scripts/check-secrets.mjs",
    "data:basemap": "node scripts/build-basemap.mjs",
    "data:geonames": "node scripts/fetch-geonames.mjs",
    "validate:assets": "tsx scripts/validate-assets.ts",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "copy:maplibre-worker": "node scripts/copy-maplibre-worker.mjs",
    "docker:build": "docker build -t history-atlas:local .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-sc": "5.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@turf/turf": "7.4.0",
    "chardet": "2.2.0",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "file-type": "22.2.0",
    "iconv-lite": "0.7.3",
    "jszip": "3.10.2",
    "lucide-react": "1.59.0",
    "maplibre-gl": "6.14.0",
    "next": "16.4.2",
    "opencc-js": "1.4.2",
    "p-retry": "8.0.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
